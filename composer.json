{
    "name": "stimata/oauth-laravel",
    "description": "Laravel SDK for Stimata OAuth",
    "type": "library",
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Stimata\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Stimata\\StimataServiceProvider"
            ],
            "aliases": {
                "Stimata": "Stimata\\Facades\\Stimata"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}